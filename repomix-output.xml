 677: # ------------------------------------------------------------------
 678: # OAuth 2.1 Authorization Code + PKCE for remote transports
 679: # ------------------------------------------------------------------
 680: 
 681: 
 682: class OAuthAuthorizationMiddleware:
 683:     """ASGI middleware implementing OAuth 2.1 authorization code flow with PKCE.
 684: 
 685:     This is a minimal single-user OAuth server that satisfies Claude.ai's
 686:     MCP connector requirements. It implements:
 687: 
 688:     - GET /.well-known/oauth-authorization-server → server metadata (RFC 8414)
 689:     - GET /.well-known/oauth-protected-resource → resource metadata
 690:     - GET /authorize → authorization page (user clicks to approve)
 691:     - POST /token → authorization code → access token exchange (with PKCE)
 692:     - Bearer token validation on all other HTTP requests
 693: 
 694:     Auth codes are single-use and short-lived (in-memory, lost on restart).
 695:     Since this is a single-user server, the "authorization" is just confirming
 696:     you're the server owner.
 697: 
 698:     Env vars:
 699:     - MCP_OAUTH_CLIENT_ID: Expected client_id from Claude.ai
 700:     - MCP_OAUTH_CLIENT_SECRET: Expected client_secret from Claude.ai
 701:     - MCP_AUTH_TOKEN: The access token issued and validated
 702:     - MCP_BASE_URL: Public base URL (for metadata endpoints)
 703:     """
 704: 
 705:     def __init__(
 706:         self,
 707:         app,
 708:         *,
 709:         client_id: str,
 710:         client_secret: str,
 711:         access_token: str,
 712:         approve_secret: str,
 713:         base_url: str = "",
 714:     ):
 715:         self.app = app
 716:         self.client_id = client_id
 717:         self.client_secret = client_secret
 718:         self.access_token = access_token
 719:         self.approve_secret = approve_secret
 720:         self.base_url = base_url.rstrip("/")
 721:         # In-memory store for pending auth codes: code -> {code_challenge, redirect_uri, state, created_at}
 722:         self._pending_codes: dict[str, dict] = {}
 723:         # Per-IP failed approve-secret attempts: ip -> {count, reset_at}
 724:         self._auth_attempts: dict[str, dict] = {}
 725: 
 726:     def _cleanup_expired(self) -> None:
 727:         """Lazy eviction of expired pending codes and stale rate-limit entries."""
 728:         now = time.monotonic()
 729:         for code in [
 730:             c for c, meta in self._pending_codes.items()
 731:             if now - meta.get("created_at", 0) > CODE_TTL_S
 732:         ]:
 733:             self._pending_codes.pop(code, None)
 734:         for ip in [
 735:             i for i, entry in self._auth_attempts.items()
 736:             if now > entry.get("reset_at", 0)
 737:         ]:
 738:             self._auth_attempts.pop(ip, None)
 739: 
 740:     def _client_ip(self, scope, headers) -> str:
 741:         """Best-effort client IP, proxy-aware.
 742: 
 743:         Railway's edge appends the real client IP as the LAST entry of
 744:         X-Forwarded-For. The left-most entries are client-supplied and
 745:         spoofable, so we deliberately take the last one. This assumes a
 746:         single trusted hop (Railway edge). If this ever runs behind an
 747:         additional proxy (e.g. Cloudflare -> Railway), this index must change.
 748:         """
 749:         xff = headers.get(b"x-forwarded-for", b"").decode()
 750:         if xff:
 751:             return xff.split(",")[-1].strip()
 752:         client = scope.get("client")
 753:         return client[0] if client else "unknown"
 754: 
 755:     async def __call__(self, scope, receive, send):
 756:         if scope["type"] != "http":
 757:             await self.app(scope, receive, send)
 758:             return
 759: 
 760:         path = scope.get("path", "")
 761:         method = scope.get("method", "GET")
 762: 
 763:         # OAuth metadata discovery (RFC 8414)
 764:         if path == "/.well-known/oauth-authorization-server" and method == "GET":
 765:             from starlette.responses import JSONResponse
 766: 
 767:             response = JSONResponse(
 768:                 {
 769:                     "issuer": self.base_url,
 770:                     "authorization_endpoint": f"{self.base_url}/authorize",
 771:                     "token_endpoint": f"{self.base_url}/token",
 772:                     "registration_endpoint": f"{self.base_url}/register",
 773:                     "token_endpoint_auth_methods_supported": [
 774:                         "client_secret_post",
 775:                     ],
 776:                     "grant_types_supported": [
 777:                         "authorization_code",
 778:                     ],
 779:                     "response_types_supported": ["code"],
 780:                     "code_challenge_methods_supported": ["S256"],
 781:                     "scopes_supported": ["mcp"],
 782:                 }
 783:             )
 784:             await response(scope, receive, send)
 785:             return
 786: 
 787:         # OAuth Protected Resource metadata
 788:         if path == "/.well-known/oauth-protected-resource" and method == "GET":
 789:             from starlette.responses import JSONResponse
 790: 
 791:             response = JSONResponse(
 792:                 {
 793:                     "resource": self.base_url,
 794:                     "authorization_servers": [self.base_url],
 795:                     "scopes_supported": ["mcp"],
 796:                 }
 797:             )
 798:             await response(scope, receive, send)
 799:             return
 800: 
 801:         # Dynamic client registration (stub -- just echoes back the client_id)
 802:         if path == "/register" and method == "POST":
 803:             await self._handle_register(scope, receive, send)
 804:             return
 805: 
 806:         # Authorization endpoint
 807:         if path == "/authorize" and method == "GET":
 808:             await self._handle_authorize(scope, receive, send)
 809:             return
 810: 
 811:         # Authorize form submission
 812:         if path == "/authorize" and method == "POST":
 813:             await self._handle_authorize_submit(scope, receive, send)
 814:             return
 815: 
 816:         # Token endpoint
 817:         if path == "/token" and method == "POST":
 818:             await self._handle_token(scope, receive, send)
 819:             return
 820: 
 821:         # Favicon (don't 401 on this during authorize page load)
 822:         if path == "/favicon.ico":
 823:             from starlette.responses import Response
 824: 
 825:             await Response(status_code=404)(scope, receive, send)
 826:             return
 827: 
 828:         # All other requests: validate bearer token
 829:         headers = dict(scope.get("headers", []))
 830:         auth_value = headers.get(b"authorization", b"").decode()
 831:         if not _safe_equal(auth_value, f"Bearer {self.access_token}"):
 832:             from starlette.responses import Response
 833: 
 834:             # Return 401 with WWW-Authenticate header per MCP spec
 835:             response = Response(
 836:                 content='{"error": "unauthorized"}',
 837:                 status_code=401,
 838:                 headers={
 839:                     "WWW-Authenticate": "Bearer",
 840:                     "Content-Type": "application/json",
 841:                 },
 842:             )
 843:             await response(scope, receive, send)
 844:             return
 845: 
 846:         await self.app(scope, receive, send)
 847: 
 848:     async def _handle_register(self, scope, receive, send):
 849:         """Handle POST /register (OAuth 2.0 Dynamic Client Registration).
 850: 
 851:         Minimal implementation that accepts any registration and returns
 852:         the provided client_name with pre-configured credentials.
 853:         """
 854:         from starlette.responses import JSONResponse
 855: 
 856:         try:
 857:             body = await self._read_body(receive)
 858:         except ValueError:
 859:             from starlette.responses import Response
 860: 
 861:             await Response("Request body too large", status_code=413)(scope, receive, send)
 862:             return
 863:         try:
 864:             import json as _json
 865: 
 866:             data = _json.loads(body)
 867:         except Exception:
 868:             data = {}
 869: 
 870:         # Per RFC 7591: do NOT echo the client_secret back. client_secret_expires_at=0
 871:         # signals a non-expiring secret already known to the client. This avoids
 872:         # handing credentials to any anonymous caller of /register.
 873:         response = JSONResponse(
 874:             {
 875:                 "client_id": self.client_id,
 876:                 "client_secret_expires_at": 0,
 877:                 "client_name": data.get("client_name", "mcp-client"),
 878:                 "redirect_uris": data.get("redirect_uris", []),
 879:                 "grant_types": ["authorization_code"],
 880:                 "response_types": ["code"],
 881:                 "token_endpoint_auth_method": "client_secret_post",
 882:             },
 883:             status_code=201,
 884:         )
 885:         await response(scope, receive, send)
 886: 
 887:     def _render_approve_page(
 888:         self,
 889:         *,
 890:         client_id,
 891:         redirect_uri,
 892:         code_challenge,
 893:         code_challenge_method,
 894:         state,
 895:         error: str = "",
 896:     ) -> str:
 897:         """Render the approval page. Shared by GET and failed/throttled POST."""
 898:         e = _html_escape
 899:         err_html = f'<p class="err">{e(error)}</p>' if error else ""
 900:         return f"""<!DOCTYPE html>
 901: <html>
 902: <head>
 903:     <title>Authorize MCP Access</title>
 904:     <meta name="viewport" content="width=device-width, initial-scale=1">
 905:     <style>
 906:         body {{ font-family: system-ui, sans-serif; max-width: 480px; margin: 60px auto; padding: 20px; }}
 907:         h1 {{ font-size: 1.4em; }}
 908:         .info {{ background: #f0f4f8; padding: 16px; border-radius: 8px; margin: 20px 0; }}
 909:         .err {{ color: #b91c1c; font-weight: 600; margin: 8px 0; }}
 910:         label {{ display: block; margin: 16px 0 6px; font-weight: 600; }}
 911:         input[type=password] {{ width: 100%; padding: 10px; font-size: 16px; box-sizing: border-box;
 912:                                 border: 1px solid #cbd5e1; border-radius: 6px; }}
 913:         button {{ background: #2563eb; color: white; border: none; padding: 12px 32px;
 914:                  border-radius: 6px; font-size: 16px; cursor: pointer; margin-top: 16px; }}
 915:         button:hover {{ background: #1d4ed8; }}
 916:     </style>
 917: </head>
 918: <body>
 919:     <h1>Authorize Cronometer MCP</h1>
 920:     <div class="info">
 921:         <p><strong>Client:</strong> {e(client_id) or "unknown"}</p>
 922:         <p>Enter the access secret to grant this client access to your
 923:            Cronometer nutrition data.</p>
 924:     </div>
 925:     {err_html}
 926:     <form method="POST" action="/authorize">
 927:         <input type="hidden" name="client_id" value="{e(client_id)}">
 928:         <input type="hidden" name="redirect_uri" value="{e(redirect_uri)}">
 929:         <input type="hidden" name="code_challenge" value="{e(code_challenge)}">
 930:         <input type="hidden" name="code_challenge_method" value="{e(code_challenge_method)}">
 931:         <input type="hidden" name="state" value="{e(state)}">
 932:         <label for="approve_secret">Access secret</label>
 933:         <input id="approve_secret" type="password" name="approve_secret" autocomplete="off" autofocus required>
 934:         <button type="submit">Authorize</button>
 935:     </form>
 936: </body>
 937: </html>"""
 938: 
 939:     async def _handle_authorize(self, scope, receive, send):
 940:         """Handle GET /authorize -- show the approval page (secret entered on POST)."""
 941:         from starlette.responses import HTMLResponse
 942:         from urllib.parse import parse_qs
 943: 
 944:         query = scope.get("query_string", b"").decode()
 945:         params = parse_qs(query)
 946: 
 947:         client_id = params.get("client_id", [None])[0]
 948:         redirect_uri = params.get("redirect_uri", [None])[0]
 949:         code_challenge = params.get("code_challenge", [None])[0]
 950:         code_challenge_method = params.get("code_challenge_method", [None])[0]
 951:         state = params.get("state", [None])[0]
 952:         response_type = params.get("response_type", [None])[0]
 953: 
 954:         if response_type != "code" or not redirect_uri or not code_challenge:
 955:             from starlette.responses import JSONResponse
 956: 
 957:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 958:             await response(scope, receive, send)
 959:             return
 960: 
 961:         html = self._render_approve_page(
 962:             client_id=client_id,
 963:             redirect_uri=redirect_uri,
 964:             code_challenge=code_challenge,
 965:             code_challenge_method=code_challenge_method,
 966:             state=state,
 967:         )
 968:         response = HTMLResponse(html)
 969:         await response(scope, receive, send)
 970: 
 971:     async def _handle_authorize_submit(self, scope, receive, send):
 972:         """Handle POST /authorize -- validate the approve secret, then issue a code."""
 973:         from starlette.responses import HTMLResponse, JSONResponse, RedirectResponse
 974:         from urllib.parse import parse_qs, urlencode
 975:         import secrets
 976: 
 977:         try:
 978:             body = await self._read_body(receive)
 979:         except ValueError:
 980:             from starlette.responses import Response
 981: 
 982:             await Response("Request body too large", status_code=413)(scope, receive, send)
 983:             return
 984:         params = parse_qs(body.decode("utf-8"))
 985: 
 986:         redirect_uri = params.get("redirect_uri", [None])[0]
 987:         code_challenge = params.get("code_challenge", [None])[0]
 988:         code_challenge_method = params.get("code_challenge_method", [None])[0]
 989:         state = params.get("state", [None])[0]
 990:         client_id = params.get("client_id", [None])[0]
 991:         approve_secret = params.get("approve_secret", [None])[0]
 992: 
 993:         if not redirect_uri or not code_challenge:
 994:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 995:             await response(scope, receive, send)
 996:             return
 997: 
 998:         self._cleanup_expired()
 999: 
1000:         headers = dict(scope.get("headers", []))
1001:         ip = self._client_ip(scope, headers)
1002:         now = time.monotonic()
1003: 
1004:         # Brute-force throttle: block before checking the secret.
1005:         entry = self._auth_attempts.get(ip)
1006:         if entry and now < entry["reset_at"] and entry["count"] >= MAX_AUTH_ATTEMPTS:
1007:             html = self._render_approve_page(
1008:                 client_id=client_id,
1009:                 redirect_uri=redirect_uri,
1010:                 code_challenge=code_challenge,
1011:                 code_challenge_method=code_challenge_method,
1012:                 state=state,
1013:                 error="Too many attempts. Wait a minute and try again.",
1014:             )
1015:             await HTMLResponse(html, status_code=429)(scope, receive, send)
1016:             return
1017: 
1018:         # Validate the approve secret (constant-time).
1019:         if not approve_secret or not _safe_equal(approve_secret, self.approve_secret):
1020:             e = self._auth_attempts.get(ip)
1021:             if not e or now > e["reset_at"]:
1022:                 self._auth_attempts[ip] = {"count": 1, "reset_at": now + AUTH_WINDOW_S}
1023:             else:
1024:                 e["count"] += 1
1025:             html = self._render_approve_page(
1026:                 client_id=client_id,
1027:                 redirect_uri=redirect_uri,
1028:                 code_challenge=code_challenge,
1029:                 code_challenge_method=code_challenge_method,
1030:                 state=state,
1031:                 error="Incorrect secret. Try again.",
1032:             )
1033:             await HTMLResponse(html, status_code=403)(scope, receive, send)
1034:             return
1035: 
1036:         # Success -- clear any failed-attempt record for this IP.
1037:         self._auth_attempts.pop(ip, None)
1038: 
1039:         # Backstop cap on the pending-code store.
1040:         if len(self._pending_codes) >= MAX_PENDING_CODES:
1041:             self._cleanup_expired()
1042:             if len(self._pending_codes) >= MAX_PENDING_CODES:
1043:                 await JSONResponse(
1044:                     {"error": "server_error",
1045:                      "error_description": "Too many pending authorizations"},
1046:                     status_code=503,
1047:                 )(scope, receive, send)
1048:                 return
1049: 
1050:         # Generate a one-time auth code with a creation timestamp (TTL enforced at /token).
1051:         code = secrets.token_urlsafe(32)
1052:         self._pending_codes[code] = {
1053:             "code_challenge": code_challenge,
1054:             "code_challenge_method": code_challenge_method or "S256",
1055:             "redirect_uri": redirect_uri,
1056:             "created_at": now,
1057:         }
1058: 
1059:         # Redirect back to Claude.ai with the code
1060:         callback_params = {"code": code}
1061:         if state:
1062:             callback_params["state"] = state
1063:         separator = "&" if "?" in redirect_uri else "?"
1064:         redirect_url = f"{redirect_uri}{separator}{urlencode(callback_params)}"
1065: 
1066:         response = RedirectResponse(url=redirect_url, status_code=302)
1067:         await response(scope, receive, send)
1068: 
1069:     async def _handle_token(self, scope, receive, send):
1070:         """Handle POST /token (authorization code exchange with PKCE)."""
1071:         from starlette.responses import JSONResponse
1072:         from urllib.parse import parse_qs
1073:         import hashlib
1074:         import base64
1075: 
1076:         try:
1077:             body = await self._read_body(receive)
1078:         except ValueError:
1079:             from starlette.responses import Response
1080: 
1081:             await Response("Request body too large", status_code=413)(scope, receive, send)
1082:             return
1083:         try:
1084:             params = parse_qs(body.decode("utf-8"))
1085:         except Exception:
1086:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
1087:             await response(scope, receive, send)
1088:             return
1089: 
1090:         grant_type = params.get("grant_type", [None])[0]
1091:         code = params.get("code", [None])[0]
1092:         code_verifier = params.get("code_verifier", [None])[0]
1093: 
1094:         if grant_type != "authorization_code":
1095:             response = JSONResponse(
1096:                 {"error": "unsupported_grant_type"}, status_code=400
1097:             )
1098:             await response(scope, receive, send)
1099:             return
1100: 
1101:         if not code or not code_verifier:
1102:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
1103:             await response(scope, receive, send)
1104:             return
1105: 
1106:         # Look up and consume the auth code (single-use)
1107:         pending = self._pending_codes.pop(code, None)
1108:         if pending is None:
1109:             response = JSONResponse({"error": "invalid_grant"}, status_code=400)
1110:             await response(scope, receive, send)
1111:             return
1112: 
1113:         # Reject expired codes (TTL enforced here since codes are consumed on use).
1114:         if time.monotonic() - pending.get("created_at", 0) > CODE_TTL_S:
1115:             response = JSONResponse(
1116:                 {"error": "invalid_grant", "error_description": "Code expired"},
1117:                 status_code=400,
1118:             )
1119:             await response(scope, receive, send)
1120:             return
1121: 
1122:         # Validate PKCE: S256(code_verifier) must match code_challenge
1123:         code_challenge = pending["code_challenge"]
1124:         digest = hashlib.sha256(code_verifier.encode("ascii")).digest()
1125:         computed_challenge = (
1126:             base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
1127:         )
1128: 
1129:         if computed_challenge != code_challenge:
1130:             response = JSONResponse(
1131:                 {
1132:                     "error": "invalid_grant",
1133:                     "error_description": "PKCE verification failed",
1134:                 },
1135:                 status_code=400,
1136:             )
1137:             await response(scope, receive, send)
1138:             return
1139: 
1140:         # Issue access token
1141:         response = JSONResponse(
1142:             {
1143:                 "access_token": self.access_token,
1144:                 "token_type": "bearer",
1145:                 "scope": "mcp",
1146:             }
1147:         )
1148:         await response(scope, receive, send)
1149: 
1150:     @staticmethod
1151:     async def _read_body(receive) -> bytes:
1152:         """Read the full request body from ASGI receive, capped at MAX_BODY_BYTES."""
1153:         body = b""
1154:         while True:
1155:             message = await receive()
1156:             body += message.get("body", b"")
1157:             if len(body) > MAX_BODY_BYTES:
1158:                 raise ValueError("Request body too large")
1159:             if not message.get("more_body", False):
1160:                 break
1161:         return body
1162: 
1163: 
1164: # ------------------------------------------------------------------
1165: # Entry point
1166: # ------------------------------------------------------------------
1167: 
1168: 
1169: def main():
1170:     # Load .env for local development. No-op if the file is missing.
1171:     # override=False keeps real environment variables (Docker, systemd,
1172:     # MCP client `env` blocks, etc.) authoritative over .env.
1173:     from dotenv import find_dotenv, load_dotenv
1174: 
1175:     dotenv_path = find_dotenv(usecwd=True)
1176:     if dotenv_path and load_dotenv(dotenv_path, override=False):
1177:         logger.info("Loaded .env from %s", dotenv_path)
1178: 
1179:     transport = os.getenv("MCP_TRANSPORT", "stdio")
1180: 
1181:     if transport == "stdio":
1182:         mcp.run(transport="stdio")
1183: 
1184:     elif transport in ("sse", "streamable-http"):
1185:         import uvicorn
1186: 
1187:         host = os.getenv("FASTMCP_HOST", "0.0.0.0")
1188:         port = int(os.getenv("PORT", os.getenv("FASTMCP_PORT", "8000")))
1189: 
1190:         if transport == "sse":
1191:             app = mcp.sse_app()
1192:         else:
1193:             app = mcp.streamable_http_app()
1194: 
1195:         # OAuth config for remote transports
1196:         client_id = os.getenv("MCP_OAUTH_CLIENT_ID", "")
1197:         client_secret = os.getenv("MCP_OAUTH_CLIENT_SECRET", "")
1198:         access_token = os.getenv("MCP_AUTH_TOKEN")
1199:         approve_secret = os.getenv("MCP_APPROVE_SECRET")
1200:         base_url = os.getenv("MCP_BASE_URL", f"http://localhost:{port}")
1201: 
1202:         # Fail closed: a public remote transport must be authenticated. Refuse to
1203:         # start rather than silently serving every tool unauthenticated.
1204:         if not access_token or not approve_secret:
1205:             raise RuntimeError(
1206:                 "Remote transport requires MCP_AUTH_TOKEN and MCP_APPROVE_SECRET. "
1207:                 "Refusing to start unauthenticated."
1208:             )
1209:         if len(approve_secret) < 16:
1210:             raise RuntimeError(
1211:                 "MCP_APPROVE_SECRET too short (min 16 chars). Generate: openssl rand -hex 32"
1212:             )
1213:         if not base_url.startswith("https://"):
1214:             logger.warning(
1215:                 "MCP_BASE_URL is not HTTPS (%s). OAuth metadata will advertise "
1216:                 "insecure endpoints. Set MCP_BASE_URL to your public HTTPS URL "
1217:                 "for production.",
1218:                 base_url,
1219:             )
1220: 
1221:         logger.info("OAuth authorization code flow enabled")
1222:         app = OAuthAuthorizationMiddleware(
1223:             app,
1224:             client_id=client_id,
1225:             client_secret=client_secret,
1226:             access_token=access_token,
1227:             approve_secret=approve_secret,
1228:             base_url=base_url,
1229:         )
1230: 
1231:         logger.info("Starting %s transport on %s:%d", transport, host, port)
1232:         config = uvicorn.Config(app, host=host, port=port, log_level="info")
1233:         server = uvicorn.Server(config)
1234:         server.run()
1235: 
1236:     else:
1237:         raise ValueError(
1238:             f"Unknown MCP_TRANSPORT: {transport!r}. "
1239:             "Must be 'stdio', 'sse', or 'streamable-http'."
1240:         )
1241: 
1242: 
1243: if __name__ == "__main__":
1244:     main()
