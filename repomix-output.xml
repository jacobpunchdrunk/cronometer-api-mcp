   1: """MCP server for Cronometer nutrition data via the mobile REST API."""
   2: 
   3: import json
   4: import logging
   5: import os
   6: from datetime import date, timedelta
   7: 
   8: from mcp.server.fastmcp import FastMCP
   9: from mcp.server.transport_security import TransportSecuritySettings
  10: 
  11: from .client import CronometerClient
  12: 
  13: logging.basicConfig(level=logging.INFO)
  14: logger = logging.getLogger(__name__)
  15: 
  16: mcp = FastMCP(
  17:     "cronometer",
  18:     instructions=(
  19:         "Cronometer MCP server for nutrition tracking via the mobile REST API. "
  20:         "Provides access to food search, diary management, daily nutrition data, "
  21:         "macro targets, biometrics, and fasting history from Cronometer. "
  22:         "Use search_foods to find foods, get_food_details for nutrition info "
  23:         "and serving sizes, add_food_entry to log meals, and get_food_log to "
  24:         "review what was eaten."
  25:     ),
  26:     transport_security=TransportSecuritySettings(
  27:         enable_dns_rebinding_protection=False,
  28:     ),
  29: )
  30: 
  31: _client: CronometerClient | None = None
  32: 
  33: 
  34: def _get_client() -> CronometerClient:
  35:     global _client
  36:     if _client is None:
  37:         _client = CronometerClient()
  38:     return _client
  39: 
  40: 
  41: def _parse_date(d: str | None) -> date | None:
  42:     if d is None:
  43:         return None
  44:     return date.fromisoformat(d)
  45: 
  46: 
  47: def _ok(data: dict) -> str:
  48:     """Wrap a successful response."""
  49:     return json.dumps({"status": "success", **data}, indent=2)
  50: 
  51: 
  52: def _err(e: Exception) -> str:
  53:     """Wrap an error response with actionable messages."""
  54:     import httpx
  55: 
  56:     if isinstance(e, httpx.HTTPStatusError):
  57:         status = e.response.status_code
  58:         if status == 401 or status == 403:
  59:             msg = "Authentication failed. Cronometer session may have expired -- try again."
  60:         elif status == 429:
  61:             msg = "Rate limit exceeded. Wait a few minutes before retrying."
  62:         elif status == 404:
  63:             msg = f"Resource not found (HTTP {status})."
  64:         else:
  65:             msg = f"Cronometer API error (HTTP {status})."
  66:     elif isinstance(e, httpx.TimeoutException):
  67:         msg = "Request timed out. Cronometer may be slow -- try again."
  68:     elif isinstance(e, httpx.ConnectError):
  69:         msg = "Could not connect to Cronometer. Check network connectivity."
  70:     else:
  71:         msg = f"{type(e).__name__}: {e}"
  72: 
  73:     return json.dumps({"status": "error", "message": msg})
  74: 
  75: 
  76: # ------------------------------------------------------------------
  77: # Diary: read
  78: # ------------------------------------------------------------------
  79: 
  80: 
  81: @mcp.tool(
  82:     annotations={
  83:         "readOnlyHint": True,
  84:         "destructiveHint": False,
  85:         "idempotentHint": True,
  86:         "openWorldHint": True,
  87:     }
  88: )
  89: def get_food_log(date: str | None = None) -> str:
  90:     """Get all diary entries for a given date.
  91: 
  92:     Returns every food entry logged for the day, including food names,
  93:     amounts, meal groups, and nutrient data.
  94: 
  95:     Also returns a top-level energy_summary field with pre-computed
  96:     values most relevant to the user:
  97: 
  98:       - total_target_kcal: daily calorie target dynamically adjusted
  99:         for expenditure and weight goal (equivalent to Cronometer's
 100:         "Total Target" in the Energy Summary screen)
 101:       - consumed_kcal: total calories consumed
 102:       - remaining_kcal: calories remaining to stay on target
 103:         (total_target_kcal - consumed_kcal). Always report this
 104:         when summarizing the user's day. Prefer this over manually
 105:         deriving values from the burn breakdown fields.
 106: 
 107:     Args:
 108:         date: Date as YYYY-MM-DD (defaults to today).
 109:     """
 110:     try:
 111:         client = _get_client()
 112:         day = _parse_date(date)
 113:         data = client.get_diary(day)
 114: 
 115:         summary = (data or {}).get("summary") or {}
 116:         target = (summary.get("macros") or {}).get("energy")
 117:         consumed = (summary.get("consumed") or {}).get("total")
 118:         energy_summary: dict | None = None
 119:         if target is not None and consumed is not None:
 120:             energy_summary = {
 121:                 "total_target_kcal": target,
 122:                 "consumed_kcal": consumed,
 123:                 "remaining_kcal": int(round(target - consumed)),
 124:             }
 125: 
 126:         return _ok(
 127:             {
 128:                 "date": date or str(date_module_today()),
 129:                 "energy_summary": energy_summary,
 130:                 "diary": data,
 131:             }
 132:         )
 133:     except Exception as e:
 134:         return _err(e)
 135: 
 136: 
 137: # ------------------------------------------------------------------
 138: # Diary: write
 139: # ------------------------------------------------------------------
 140: 
 141: 
 142: @mcp.tool(
 143:     annotations={
 144:         "readOnlyHint": False,
 145:         "destructiveHint": False,
 146:         "idempotentHint": False,
 147:         "openWorldHint": True,
 148:     }
 149: )
 150: def add_food_entry(
 151:     food_id: int,
 152:     measure_id: int,
 153:     grams: float,
 154:     date: str | None = None,
 155:     translation_id: int = 0,
 156:     diary_group: str = "auto",
 157: ) -> str:
 158:     """Add a food entry to the Cronometer diary.
 159: 
 160:     Use search_foods to find food_id and measure_id, then
 161:     get_food_details to confirm serving sizes and gram weights.
 162: 
 163:     Args:
 164:         food_id: Numeric food ID from search_foods results.
 165:         measure_id: Measure/unit ID from get_food_details.
 166:         grams: Weight of the serving in grams.
 167:         date: Date to log as YYYY-MM-DD (defaults to today).
 168:         translation_id: Translation ID from search results (usually 0).
 169:         diary_group: Meal slot -- one of "auto", "breakfast", "lunch",
 170:                      "dinner", "snacks" (case-insensitive, default "auto").
 171:     """
 172:     try:
 173:         group_map = {
 174:             "auto": 0,
 175:             "breakfast": 1,
 176:             "lunch": 2,
 177:             "dinner": 3,
 178:             "snacks": 4,
 179:         }
 180:         group_key = diary_group.strip().lower()
 181:         group_int = group_map.get(group_key)
 182:         if group_int is None:
 183:             return _err(
 184:                 ValueError(
 185:                     f"Invalid diary_group '{diary_group}'. "
 186:                     "Must be one of: auto, breakfast, lunch, dinner, snacks."
 187:                 )
 188:             )
 189: 
 190:         client = _get_client()
 191:         day = _parse_date(date)
 192:         result = client.add_serving(
 193:             food_id=food_id,
 194:             measure_id=measure_id,
 195:             grams=grams,
 196:             translation_id=translation_id,
 197:             day=day,
 198:             diary_group=group_int,
 199:         )
 200:         return _ok(
 201:             {
 202:                 "entry": result,
 203:                 "note": "Use the serving ID to remove this entry with remove_food_entry.",
 204:             }
 205:         )
 206:     except Exception as e:
 207:         return _err(e)
 208: 
 209: 
 210: @mcp.tool(
 211:     annotations={
 212:         "readOnlyHint": False,
 213:         "destructiveHint": True,
 214:         "idempotentHint": True,
 215:         "openWorldHint": True,
 216:     }
 217: )
 218: def remove_food_entry(
 219:     entry_ids: list[str],
 220:     date: str | None = None,
 221: ) -> str:
 222:     """Remove one or more food entries from the Cronometer diary.
 223: 
 224:     Use get_food_log to find entry IDs.
 225: 
 226:     Args:
 227:         entry_ids: List of serving/entry IDs to remove.
 228:         date: Date the entries belong to as YYYY-MM-DD (defaults to today).
 229:     """
 230:     try:
 231:         client = _get_client()
 232:         day = _parse_date(date)
 233:         result = client.delete_entries(entry_ids, day)
 234:         return _ok(
 235:             {
 236:                 "removed": result.get("removed", []),
 237:                 "count": result.get("count", 0),
 238:                 "date": date or str(date_module_today()),
 239:             }
 240:         )
 241:     except Exception as e:
 242:         return _err(e)
 243: 
 244: 
 245: # ------------------------------------------------------------------
 246: # Diary: management
 247: # ------------------------------------------------------------------
 248: 
