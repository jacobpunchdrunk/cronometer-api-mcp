270: ### 7f. `_handle_authorize_submit` (POST) — throttle + validate secret before issuing a code
271: 
272: ```python
273: # ... parse redirect_uri, code_challenge, code_challenge_method, state, approve_secret ...
274: 
275: ip = self._client_ip(scope, dict(scope.get("headers", [])))
276: now = time.monotonic()
277: 
278: # throttle check
279: entry = self._auth_attempts.get(ip)
280: if entry and now < entry["reset_at"] and entry["count"] >= MAX_AUTH_ATTEMPTS:
281:     html = self._render_approve_page(..., error="Too many attempts. Wait a minute.")
282:     await HTMLResponse(html, status_code=429)(scope, receive, send)
283:     return
284: 
285: # secret check (constant-time)
286: if not approve_secret or not _safe_equal(approve_secret, self.approve_secret):
287:     e = self._auth_attempts.get(ip)
288:     if not e or now > e["reset_at"]:
289:         self._auth_attempts[ip] = {"count": 1, "reset_at": now + AUTH_WINDOW_S}
290:     else:
291:         e["count"] += 1
292:     html = self._render_approve_page(..., error="Incorrect secret. Try again.")
293:     await HTMLResponse(html, status_code=403)(scope, receive, send)
294:     return
295: 
296: # success → clear attempts, issue code with TTL
297: self._auth_attempts.pop(ip, None)
298: code = secrets.token_urlsafe(32)
299: self._pending_codes[code] = {
300:     "code_challenge": code_challenge,
301:     "code_challenge_method": code_challenge_method or "S256",
302:     "redirect_uri": redirect_uri,
303:     "created_at": time.monotonic(),   # NEW
304: }
305: # ... existing redirect ...
306: ```
307: 
308: ### 7g. `_handle_token` — enforce TTL after consuming the code
309: 
310: ```python
311: pending = self._pending_codes.pop(code, None)
312: if pending is None:
313:     # ... existing invalid_grant ...
314:     return
315: 
316: if time.monotonic() - pending.get("created_at", 0) > CODE_TTL_S:
317:     await JSONResponse({"error": "invalid_grant",
318:                         "error_description": "Code expired"}, status_code=400)(scope, receive, send)
319:     return
320: # ... existing PKCE check ...
321: ```
