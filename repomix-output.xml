   1: """MCP server for Cronometer nutrition data via the mobile REST API."""
   2: 
   3: import hmac
   4: import json
   5: import logging
   6: import os
   7: import time
   8: from datetime import date, timedelta
   9: from hashlib import sha256
  10: from html import escape as _html_escape
  11: 
  12: from mcp.server.fastmcp import FastMCP
  13: from mcp.server.transport_security import TransportSecuritySettings
  14: 
  15: from .client import CronometerClient
  16: 
  17: logging.basicConfig(level=logging.INFO)
  18: logger = logging.getLogger(__name__)
  19: 
  20: # --- OAuth / auth-gate tunables --------------------------------------------
  21: CODE_TTL_S = 5 * 60            # pending auth codes expire 5 minutes after issue
  22: MAX_AUTH_ATTEMPTS = 5          # failed approve-secret tries per IP per window
  23: AUTH_WINDOW_S = 60             # rate-limit window
  24: MAX_BODY_BYTES = 64 * 1024     # cap on OAuth request bodies (DoS guard)
  25: MAX_PENDING_CODES = 100        # backstop cap on the pending-code store
  26: 
  27: 
  28: def _safe_equal(a: str, b: str) -> bool:
  29:     """Constant-time string comparison (length-independent via fixed-size hash)."""
  30:     return hmac.compare_digest(sha256(a.encode()).digest(), sha256(b.encode()).digest())
  31: 
  32: mcp = FastMCP(
  33:     "cronometer",
  34:     instructions=(
  35:         "Cronometer MCP server for nutrition tracking via the mobile REST API. "
  36:         "Provides access to food search, diary management, daily nutrition data, "
  37:         "macro targets, biometrics, and fasting history from Cronometer. "
  38:         "Use search_foods to find foods, get_food_details for nutrition info "
  39:         "and serving sizes, add_food_entry to log meals, and get_food_log to "
  40:         "review what was eaten."
  41:     ),
  42:     transport_security=TransportSecuritySettings(
  43:         enable_dns_rebinding_protection=False,
  44:     ),
  45: )
  46: 
  47: _client: CronometerClient | None = None
  48: 
  49: 
  50: def _get_client() -> CronometerClient:
  51:     global _client
  52:     if _client is None:
  53:         _client = CronometerClient()
  54:     return _client
  55: 
  56: 
  57: def _parse_date(d: str | None) -> date | None:
  58:     if d is None:
  59:         return None
  60:     return date.fromisoformat(d)
  61: 
  62: 
  63: def _ok(data: dict) -> str:
  64:     """Wrap a successful response."""
  65:     return json.dumps({"status": "success", **data}, indent=2)
  66: 
  67: 
  68: def _err(e: Exception) -> str:
  69:     """Wrap an error response with actionable messages."""
  70:     import httpx
  71: 
  72:     if isinstance(e, httpx.HTTPStatusError):
  73:         status = e.response.status_code
  74:         if status == 401 or status == 403:
  75:             msg = "Authentication failed. Cronometer session may have expired -- try again."
  76:         elif status == 429:
  77:             msg = "Rate limit exceeded. Wait a few minutes before retrying."
  78:         elif status == 404:
  79:             msg = f"Resource not found (HTTP {status})."
  80:         else:
  81:             msg = f"Cronometer API error (HTTP {status})."
  82:     elif isinstance(e, httpx.TimeoutException):
  83:         msg = "Request timed out. Cronometer may be slow -- try again."
  84:     elif isinstance(e, httpx.ConnectError):
  85:         msg = "Could not connect to Cronometer. Check network connectivity."
  86:     else:
  87:         msg = f"{type(e).__name__}: {e}"
  88: 
  89:     return json.dumps({"status": "error", "message": msg})
  90: 
  91: 
  92: # ------------------------------------------------------------------
  93: # Diary: read
  94: # ------------------------------------------------------------------
  95: 
  96: 
  97: @mcp.tool(
  98:     annotations={
  99:         "readOnlyHint": True,
 100:         "destructiveHint": False,
 101:         "idempotentHint": True,
 102:         "openWorldHint": True,
 103:     }
 104: )
 105: def get_food_log(date: str | None = None) -> str:
 106:     """Get all diary entries for a given date.
 107: 
 108:     Returns every food entry logged for the day, including food names,
 109:     amounts, meal groups, and nutrient data.
 110: 
 111:     Also returns a top-level energy_summary field with pre-computed
 112:     values most relevant to the user:
 113: 
 114:       - total_target_kcal: daily calorie target dynamically adjusted
 115:         for expenditure and weight goal (equivalent to Cronometer's
 116:         "Total Target" in the Energy Summary screen)
 117:       - consumed_kcal: total calories consumed
 118:       - remaining_kcal: calories remaining to stay on target
 119:         (total_target_kcal - consumed_kcal). Always report this
 120:         when summarizing the user's day. Prefer this over manually
 121:         deriving values from the burn breakdown fields.
 122: 
 123:     Args:
 124:         date: Date as YYYY-MM-DD (defaults to today).
 125:     """
 126:     try:
 127:         client = _get_client()
 128:         day = _parse_date(date)
 129:         data = client.get_diary(day)
 130: 
 131:         summary = (data or {}).get("summary") or {}
 132:         target = (summary.get("macros") or {}).get("energy")
 133:         consumed = (summary.get("consumed") or {}).get("total")
 134:         energy_summary: dict | None = None
 135:         if target is not None and consumed is not None:
 136:             energy_summary = {
 137:                 "total_target_kcal": target,
 138:                 "consumed_kcal": consumed,
 139:                 "remaining_kcal": int(round(target - consumed)),
 140:             }
 141: 
 142:         return _ok(
 143:             {
 144:                 "date": date or str(date_module_today()),
 145:                 "energy_summary": energy_summary,
 146:                 "diary": data,
 147:             }
 148:         )
 149:     except Exception as e:
 150:         return _err(e)
 151: 
 152: 
 153: # ------------------------------------------------------------------
 154: # Diary: write
 155: # ------------------------------------------------------------------
 156: 
 157: 
 158: @mcp.tool(
 159:     annotations={
 160:         "readOnlyHint": False,
 161:         "destructiveHint": False,
 162:         "idempotentHint": False,
 163:         "openWorldHint": True,
 164:     }
 165: )
 166: def add_food_entry(
 167:     food_id: int,
 168:     measure_id: int,
 169:     grams: float,
 170:     date: str | None = None,
 171:     translation_id: int = 0,
 172:     diary_group: str = "auto",
 173: ) -> str:
 174:     """Add a food entry to the Cronometer diary.
 175: 
 176:     Use search_foods to find food_id and measure_id, then
 177:     get_food_details to confirm serving sizes and gram weights.
 178: 
 179:     Args:
 180:         food_id: Numeric food ID from search_foods results.
 181:         measure_id: Measure/unit ID from get_food_details.
 182:         grams: Weight of the serving in grams.
 183:         date: Date to log as YYYY-MM-DD (defaults to today).
 184:         translation_id: Translation ID from search results (usually 0).
 185:         diary_group: Meal slot -- one of "auto", "breakfast", "lunch",
 186:                      "dinner", "snacks" (case-insensitive, default "auto").
 187:     """
 188:     try:
 189:         group_map = {
 190:             "auto": 0,
 191:             "breakfast": 1,
 192:             "lunch": 2,
 193:             "dinner": 3,
 194:             "snacks": 4,
 195:         }
 196:         group_key = diary_group.strip().lower()
 197:         group_int = group_map.get(group_key)
 198:         if group_int is None:
 199:             return _err(
 200:                 ValueError(
 201:                     f"Invalid diary_group '{diary_group}'. "
 202:                     "Must be one of: auto, breakfast, lunch, dinner, snacks."
 203:                 )
 204:             )
 205: 
 206:         client = _get_client()
 207:         day = _parse_date(date)
 208:         result = client.add_serving(
 209:             food_id=food_id,
 210:             measure_id=measure_id,
 211:             grams=grams,
 212:             translation_id=translation_id,
 213:             day=day,
 214:             diary_group=group_int,
 215:         )
 216:         return _ok(
 217:             {
 218:                 "entry": result,
 219:                 "note": "Use the serving ID to remove this entry with remove_food_entry.",
 220:             }
 221:         )
 222:     except Exception as e:
 223:         return _err(e)
 224: 
 225: 
 226: @mcp.tool(
 227:     annotations={
 228:         "readOnlyHint": False,
 229:         "destructiveHint": True,
 230:         "idempotentHint": True,
 231:         "openWorldHint": True,
 232:     }
 233: )
 234: def remove_food_entry(
 235:     entry_ids: list[str],
 236:     date: str | None = None,
 237: ) -> str:
 238:     """Remove one or more food entries from the Cronometer diary.
 239: 
 240:     Use get_food_log to find entry IDs.
 241: 
 242:     Args:
 243:         entry_ids: List of serving/entry IDs to remove.
 244:         date: Date the entries belong to as YYYY-MM-DD (defaults to today).
 245:     """
 246:     try:
 247:         client = _get_client()
 248:         day = _parse_date(date)
 249:         result = client.delete_entries(entry_ids, day)
 250:         return _ok(
 251:             {
 252:                 "removed": result.get("removed", []),
 253:                 "count": result.get("count", 0),
 254:                 "date": date or str(date_module_today()),
 255:             }
 256:         )
 257:     except Exception as e:
 258:         return _err(e)
 259: 
 260: 
 261: # ------------------------------------------------------------------
 262: # Diary: management
 263: # ------------------------------------------------------------------
 264: 
 265: 
 266: @mcp.tool(
 267:     annotations={
 268:         "readOnlyHint": False,
 269:         "destructiveHint": False,
 270:         "idempotentHint": True,
 271:         "openWorldHint": True,
 272:     }
 273: )
 274: def mark_day_complete(date: str, complete: bool = True) -> str:
 275:     """Mark a diary day as complete or incomplete.
 276: 
 277:     Args:
 278:         date: Date to mark as YYYY-MM-DD.
 279:         complete: True to mark complete, False for incomplete.
 280:     """
 281:     try:
 282:         client = _get_client()
 283:         day = _parse_date(date)
 284:         result = client.mark_day_complete(day, complete)
 285:         status = "complete" if complete else "incomplete"
 286:         return _ok(
 287:             {
 288:                 "date": date,
 289:                 "marked": status,
 290:                 "result": result,
 291:             }
 292:         )
 293:     except Exception as e:
 294:         return _err(e)
 295: 
 296: 
 297: @mcp.tool(
 298:     annotations={
 299:         "readOnlyHint": False,
 300:         "destructiveHint": False,
 301:         "idempotentHint": False,
 302:         "openWorldHint": True,
 303:     }
 304: )
 305: def copy_day(date: str | None = None) -> str:
 306:     """Copy all diary entries from the previous day to the given date.
 307: 
 308:     Additive -- does not remove existing entries on the destination date.
