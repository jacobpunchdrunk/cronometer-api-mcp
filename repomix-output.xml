 661: # ------------------------------------------------------------------
 662: # OAuth 2.1 Authorization Code + PKCE for remote transports
 663: # ------------------------------------------------------------------
 664: 
 665: 
 666: class OAuthAuthorizationMiddleware:
 667:     """ASGI middleware implementing OAuth 2.1 authorization code flow with PKCE.
 668: 
 669:     This is a minimal single-user OAuth server that satisfies Claude.ai's
 670:     MCP connector requirements. It implements:
 671: 
 672:     - GET /.well-known/oauth-authorization-server → server metadata (RFC 8414)
 673:     - GET /.well-known/oauth-protected-resource → resource metadata
 674:     - GET /authorize → authorization page (user clicks to approve)
 675:     - POST /token → authorization code → access token exchange (with PKCE)
 676:     - Bearer token validation on all other HTTP requests
 677: 
 678:     Auth codes are single-use and short-lived (in-memory, lost on restart).
 679:     Since this is a single-user server, the "authorization" is just confirming
 680:     you're the server owner.
 681: 
 682:     Env vars:
 683:     - MCP_OAUTH_CLIENT_ID: Expected client_id from Claude.ai
 684:     - MCP_OAUTH_CLIENT_SECRET: Expected client_secret from Claude.ai
 685:     - MCP_AUTH_TOKEN: The access token issued and validated
 686:     - MCP_BASE_URL: Public base URL (for metadata endpoints)
 687:     """
 688: 
 689:     def __init__(
 690:         self,
 691:         app,
 692:         *,
 693:         client_id: str,
 694:         client_secret: str,
 695:         access_token: str,
 696:         base_url: str = "",
 697:     ):
 698:         self.app = app
 699:         self.client_id = client_id
 700:         self.client_secret = client_secret
 701:         self.access_token = access_token
 702:         self.base_url = base_url.rstrip("/")
 703:         # In-memory store for pending auth codes: code -> {code_challenge, redirect_uri, state}
 704:         self._pending_codes: dict[str, dict] = {}
 705: 
 706:     async def __call__(self, scope, receive, send):
 707:         if scope["type"] != "http":
 708:             await self.app(scope, receive, send)
 709:             return
 710: 
 711:         path = scope.get("path", "")
 712:         method = scope.get("method", "GET")
 713: 
 714:         # OAuth metadata discovery (RFC 8414)
 715:         if path == "/.well-known/oauth-authorization-server" and method == "GET":
 716:             from starlette.responses import JSONResponse
 717: 
 718:             response = JSONResponse(
 719:                 {
 720:                     "issuer": self.base_url,
 721:                     "authorization_endpoint": f"{self.base_url}/authorize",
 722:                     "token_endpoint": f"{self.base_url}/token",
 723:                     "registration_endpoint": f"{self.base_url}/register",
 724:                     "token_endpoint_auth_methods_supported": [
 725:                         "client_secret_post",
 726:                     ],
 727:                     "grant_types_supported": [
 728:                         "authorization_code",
 729:                     ],
 730:                     "response_types_supported": ["code"],
 731:                     "code_challenge_methods_supported": ["S256"],
 732:                     "scopes_supported": ["mcp"],
 733:                 }
 734:             )
 735:             await response(scope, receive, send)
 736:             return
 737: 
 738:         # OAuth Protected Resource metadata
 739:         if path == "/.well-known/oauth-protected-resource" and method == "GET":
 740:             from starlette.responses import JSONResponse
 741: 
 742:             response = JSONResponse(
 743:                 {
 744:                     "resource": self.base_url,
 745:                     "authorization_servers": [self.base_url],
 746:                     "scopes_supported": ["mcp"],
 747:                 }
 748:             )
 749:             await response(scope, receive, send)
 750:             return
 751: 
 752:         # Dynamic client registration (stub -- just echoes back the client_id)
 753:         if path == "/register" and method == "POST":
 754:             await self._handle_register(scope, receive, send)
 755:             return
 756: 
 757:         # Authorization endpoint
 758:         if path == "/authorize" and method == "GET":
 759:             await self._handle_authorize(scope, receive, send)
 760:             return
 761: 
 762:         # Authorize form submission
 763:         if path == "/authorize" and method == "POST":
 764:             await self._handle_authorize_submit(scope, receive, send)
 765:             return
 766: 
 767:         # Token endpoint
 768:         if path == "/token" and method == "POST":
 769:             await self._handle_token(scope, receive, send)
 770:             return
 771: 
 772:         # Favicon (don't 401 on this during authorize page load)
 773:         if path == "/favicon.ico":
 774:             from starlette.responses import Response
 775: 
 776:             await Response(status_code=404)(scope, receive, send)
 777:             return
 778: 
 779:         # All other requests: validate bearer token
 780:         headers = dict(scope.get("headers", []))
 781:         auth_value = headers.get(b"authorization", b"").decode()
 782:         if auth_value != f"Bearer {self.access_token}":
 783:             from starlette.responses import Response
 784: 
 785:             # Return 401 with WWW-Authenticate header per MCP spec
 786:             response = Response(
 787:                 content='{"error": "unauthorized"}',
 788:                 status_code=401,
 789:                 headers={
 790:                     "WWW-Authenticate": "Bearer",
 791:                     "Content-Type": "application/json",
 792:                 },
 793:             )
 794:             await response(scope, receive, send)
 795:             return
 796: 
 797:         await self.app(scope, receive, send)
 798: 
 799:     async def _handle_register(self, scope, receive, send):
 800:         """Handle POST /register (OAuth 2.0 Dynamic Client Registration).
 801: 
 802:         Minimal implementation that accepts any registration and returns
 803:         the provided client_name with pre-configured credentials.
 804:         """
 805:         from starlette.responses import JSONResponse
 806: 
 807:         body = await self._read_body(receive)
 808:         try:
 809:             import json as _json
 810: 
 811:             data = _json.loads(body)
 812:         except Exception:
 813:             data = {}
 814: 
 815:         response = JSONResponse(
 816:             {
 817:                 "client_id": self.client_id,
 818:                 "client_secret": self.client_secret,
 819:                 "client_name": data.get("client_name", "mcp-client"),
 820:                 "redirect_uris": data.get("redirect_uris", []),
 821:                 "grant_types": ["authorization_code"],
 822:                 "response_types": ["code"],
 823:                 "token_endpoint_auth_method": "client_secret_post",
 824:             },
 825:             status_code=201,
 826:         )
 827:         await response(scope, receive, send)
 828: 
 829:     async def _handle_authorize(self, scope, receive, send):
 830:         """Handle GET /authorize -- show a simple approval page."""
 831:         from starlette.responses import HTMLResponse
 832:         from urllib.parse import parse_qs
 833: 
 834:         query = scope.get("query_string", b"").decode()
 835:         params = parse_qs(query)
 836: 
 837:         client_id = params.get("client_id", [None])[0]
 838:         redirect_uri = params.get("redirect_uri", [None])[0]
 839:         code_challenge = params.get("code_challenge", [None])[0]
 840:         code_challenge_method = params.get("code_challenge_method", [None])[0]
 841:         state = params.get("state", [None])[0]
 842:         response_type = params.get("response_type", [None])[0]
 843: 
 844:         if response_type != "code" or not redirect_uri or not code_challenge:
 845:             from starlette.responses import JSONResponse
 846: 
 847:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 848:             await response(scope, receive, send)
 849:             return
 850: 
 851:         # Render a simple approval page
 852:         html = f"""<!DOCTYPE html>
 853: <html>
 854: <head>
 855:     <title>Authorize MCP Access</title>
 856:     <meta name="viewport" content="width=device-width, initial-scale=1">
 857:     <style>
 858:         body {{ font-family: system-ui, sans-serif; max-width: 480px; margin: 60px auto; padding: 20px; }}
 859:         h1 {{ font-size: 1.4em; }}
 860:         .info {{ background: #f0f4f8; padding: 16px; border-radius: 8px; margin: 20px 0; }}
 861:         button {{ background: #2563eb; color: white; border: none; padding: 12px 32px;
 862:                  border-radius: 6px; font-size: 16px; cursor: pointer; }}
 863:         button:hover {{ background: #1d4ed8; }}
 864:     </style>
 865: </head>
 866: <body>
 867:     <h1>Authorize Cronometer MCP</h1>
 868:     <div class="info">
 869:         <p><strong>Client:</strong> {client_id or "unknown"}</p>
 870:         <p>This will grant access to your Cronometer nutrition data
 871:            through the MCP protocol.</p>
 872:     </div>
 873:     <form method="POST" action="/authorize">
 874:         <input type="hidden" name="client_id" value="{client_id or ""}">
 875:         <input type="hidden" name="redirect_uri" value="{redirect_uri or ""}">
 876:         <input type="hidden" name="code_challenge" value="{code_challenge or ""}">
 877:         <input type="hidden" name="code_challenge_method" value="{code_challenge_method or ""}">
 878:         <input type="hidden" name="state" value="{state or ""}">
 879:         <button type="submit">Authorize</button>
 880:     </form>
 881: </body>
 882: </html>"""
 883:         response = HTMLResponse(html)
 884:         await response(scope, receive, send)
 885: 
 886:     async def _handle_authorize_submit(self, scope, receive, send):
 887:         """Handle POST /authorize -- user approved, generate code and redirect."""
 888:         from starlette.responses import RedirectResponse
 889:         from urllib.parse import parse_qs, urlencode
 890:         import secrets
 891: 
 892:         body = await self._read_body(receive)
 893:         params = parse_qs(body.decode("utf-8"))
 894: 
 895:         redirect_uri = params.get("redirect_uri", [None])[0]
 896:         code_challenge = params.get("code_challenge", [None])[0]
 897:         code_challenge_method = params.get("code_challenge_method", [None])[0]
 898:         state = params.get("state", [None])[0]
 899: 
 900:         if not redirect_uri or not code_challenge:
 901:             from starlette.responses import JSONResponse
 902: 
 903:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 904:             await response(scope, receive, send)
 905:             return
 906: 
 907:         # Generate a one-time auth code
 908:         code = secrets.token_urlsafe(32)
 909:         self._pending_codes[code] = {
 910:             "code_challenge": code_challenge,
 911:             "code_challenge_method": code_challenge_method or "S256",
 912:             "redirect_uri": redirect_uri,
 913:         }
 914: 
 915:         # Redirect back to Claude.ai with the code
 916:         callback_params = {"code": code}
 917:         if state:
 918:             callback_params["state"] = state
 919:         separator = "&" if "?" in redirect_uri else "?"
 920:         redirect_url = f"{redirect_uri}{separator}{urlencode(callback_params)}"
 921: 
 922:         response = RedirectResponse(url=redirect_url, status_code=302)
 923:         await response(scope, receive, send)
 924: 
 925:     async def _handle_token(self, scope, receive, send):
 926:         """Handle POST /token (authorization code exchange with PKCE)."""
 927:         from starlette.responses import JSONResponse
 928:         from urllib.parse import parse_qs
 929:         import hashlib
 930:         import base64
 931: 
 932:         body = await self._read_body(receive)
 933:         try:
 934:             params = parse_qs(body.decode("utf-8"))
 935:         except Exception:
 936:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 937:             await response(scope, receive, send)
 938:             return
 939: 
 940:         grant_type = params.get("grant_type", [None])[0]
 941:         code = params.get("code", [None])[0]
 942:         code_verifier = params.get("code_verifier", [None])[0]
 943: 
 944:         if grant_type != "authorization_code":
 945:             response = JSONResponse(
 946:                 {"error": "unsupported_grant_type"}, status_code=400
 947:             )
 948:             await response(scope, receive, send)
 949:             return
 950: 
 951:         if not code or not code_verifier:
 952:             response = JSONResponse({"error": "invalid_request"}, status_code=400)
 953:             await response(scope, receive, send)
 954:             return
 955: 
 956:         # Look up and consume the auth code (single-use)
 957:         pending = self._pending_codes.pop(code, None)
 958:         if pending is None:
 959:             response = JSONResponse({"error": "invalid_grant"}, status_code=400)
 960:             await response(scope, receive, send)
 961:             return
 962: 
 963:         # Validate PKCE: S256(code_verifier) must match code_challenge
 964:         code_challenge = pending["code_challenge"]
 965:         digest = hashlib.sha256(code_verifier.encode("ascii")).digest()
 966:         computed_challenge = (
 967:             base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
 968:         )
 969: 
 970:         if computed_challenge != code_challenge:
 971:             response = JSONResponse(
 972:                 {
 973:                     "error": "invalid_grant",
 974:                     "error_description": "PKCE verification failed",
 975:                 },
 976:                 status_code=400,
 977:             )
 978:             await response(scope, receive, send)
 979:             return
 980: 
 981:         # Issue access token
 982:         response = JSONResponse(
 983:             {
 984:                 "access_token": self.access_token,
 985:                 "token_type": "bearer",
 986:                 "scope": "mcp",
 987:             }
 988:         )
 989:         await response(scope, receive, send)
 990: 
 991:     @staticmethod
 992:     async def _read_body(receive) -> bytes:
 993:         """Read the full request body from ASGI receive."""
 994:         body = b""
 995:         while True:
 996:             message = await receive()
 997:             body += message.get("body", b"")
 998:             if not message.get("more_body", False):
 999:                 break
1000:         return body
1001: 
1002: 
1003: # ------------------------------------------------------------------
1004: # Entry point
1005: # ------------------------------------------------------------------
1006: 
1007: 
1008: def main():
1009:     # Load .env for local development. No-op if the file is missing.
1010:     # override=False keeps real environment variables (Docker, systemd,
1011:     # MCP client `env` blocks, etc.) authoritative over .env.
1012:     from dotenv import find_dotenv, load_dotenv
1013: 
1014:     dotenv_path = find_dotenv(usecwd=True)
1015:     if dotenv_path and load_dotenv(dotenv_path, override=False):
1016:         logger.info("Loaded .env from %s", dotenv_path)
1017: 
1018:     transport = os.getenv("MCP_TRANSPORT", "stdio")
1019: 
1020:     if transport == "stdio":
1021:         mcp.run(transport="stdio")
1022: 
1023:     elif transport in ("sse", "streamable-http"):
1024:         import uvicorn
1025: 
1026:         host = os.getenv("FASTMCP_HOST", "0.0.0.0")
1027:         port = int(os.getenv("PORT", os.getenv("FASTMCP_PORT", "8000")))
1028: 
1029:         if transport == "sse":
1030:             app = mcp.sse_app()
1031:         else:
1032:             app = mcp.streamable_http_app()
1033: 
1034:         # OAuth config for remote transports
1035:         client_id = os.getenv("MCP_OAUTH_CLIENT_ID", "")
1036:         client_secret = os.getenv("MCP_OAUTH_CLIENT_SECRET", "")
1037:         access_token = os.getenv("MCP_AUTH_TOKEN")
1038:         base_url = os.getenv("MCP_BASE_URL", f"http://localhost:{port}")
1039: 
1040:         if access_token:
1041:             logger.info("OAuth authorization code flow enabled")
1042:             app = OAuthAuthorizationMiddleware(
1043:                 app,
1044:                 client_id=client_id,
1045:                 client_secret=client_secret,
1046:                 access_token=access_token,
1047:                 base_url=base_url,
1048:             )
1049:         else:
1050:             logger.warning("No auth configured -- server is unauthenticated")
1051: 
1052:         logger.info("Starting %s transport on %s:%d", transport, host, port)
1053:         config = uvicorn.Config(app, host=host, port=port, log_level="info")
1054:         server = uvicorn.Server(config)
1055:         server.run()
1056: 
1057:     else:
1058:         raise ValueError(
1059:             f"Unknown MCP_TRANSPORT: {transport!r}. "
1060:             "Must be 'stdio', 'sse', or 'streamable-http'."
1061:         )
1062: 
1063: 
1064: if __name__ == "__main__":
1065:     main()
