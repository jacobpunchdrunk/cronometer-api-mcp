<file path="src/cronometer_api_mcp/client.py">
  1: """Cronometer mobile API client.
  2: 
  3: Reverse-engineered from the Cronometer Android/Flutter app (v4.52.6).
  4: Communicates with mobile.cronometer.com/api/v2/* using clean JSON payloads.
  5: 
  6: Endpoint catalog was extracted via static analysis of libapp.so (Dart AOT
  7: snapshot) from the APK. See the calorie-estimator project for the original
  8: Frida-based traffic capture that established the auth flow and initial
  9: endpoints.
 10: """
 11: 
 12: import logging
 13: import os
 14: from datetime import date, datetime
 15: from zoneinfo import ZoneInfo
 16: 
 17: import httpx
 18: 
 19: logger = logging.getLogger(__name__)
 20: 
 21: BASE_URL = "https://mobile.cronometer.com"
 22: 
 23: # Auth block sent with every request (mimics the Android app)
 24: _APP_AUTH_TEMPLATE = {
 25:     "api": 3,
 26:     "os": "Android",
 27:     "build": "2807",
 28:     "flavour": "free",
 29: }
 30: 
 31: # Cronometer nutrient IDs (from the login response nutrient list)
 32: NUTRIENT_IDS = {
 33:     "energy": 208,
 34:     "protein": 203,
 35:     "fat": 204,
 36:     "carbs": 205,
 37:     "fiber": 291,
 38:     "sugar": 269,
 39:     "sodium": 307,
 40:     "alcohol": 221,
 41:     "net_carbs": -1205,
 42: }
 43: 
 44: 
 45: class CronometerError(Exception):
 46:     """Raised when a Cronometer API call fails."""
 47: 
 48: 
 49: class CronometerClient:
 50:     """Stateful client for the Cronometer mobile API.
 51: 
 52:     Caches the auth token in memory and reuses it across requests.
 53:     Re-authenticates automatically when the session expires.
 54:     """
 55: 
 56:     def __init__(self) -> None:
 57:         self._user_id: int | None = None
 58:         self._token: str | None = None
 59:         self._http = httpx.Client(
 60:             base_url=BASE_URL,
 61:             headers={
 62:                 "user-agent": "Dart/3.9 (dart:io)",
 63:                 "content-type": "text/plain; charset=utf-8",
 64:                 "accept-encoding": "gzip",
 65:             },
 66:             timeout=30.0,
 67:         )
 68: 
 69:     # ------------------------------------------------------------------
 70:     # Authentication
 71:     # ------------------------------------------------------------------
 72: 
 73:     def _get_credentials(self) -> tuple[str, str]:
 74:         username = os.getenv("CRONOMETER_USERNAME")
 75:         password = os.getenv("CRONOMETER_PASSWORD")
 76:         if not username or not password:
 77:             raise CronometerError(
 78:                 "CRONOMETER_USERNAME and CRONOMETER_PASSWORD env vars must be set"
 79:             )
 80:         return username, password
 81: 
 82:     def login(self) -> None:
 83:         """Authenticate with Cronometer and cache the session token."""
 84:         username, password = self._get_credentials()
 85: 
 86:         payload = {
 87:             "email": username,
 88:             "password": password,
 89:             "timezone": "America/New_York",
 90:             "userCode": None,
 91:             "build": "4.48.2 b2807-a",
 92:             "device": "Android 14 (SDK 34), Google Pixel 6 Pro",
 93:             "firebaseToken": "",
 94:             "features": {
 95:                 "food_search_config": '{"newSearch": true, "newSpellcheck": true}',
 96:                 "use_gpt_autofill": "true",
 97:             },
 98:             "auth": {
 99:                 "userId": None,
100:                 "token": None,
101:                 **_APP_AUTH_TEMPLATE,
102:             },
103:             "lastSeen": 0,
104:             "config": {"call_version": 2},
105:         }
106: 
107:         logger.info("Logging in to Cronometer as %s", username)
108:         resp = self._http.post("/api/v2/login", json=payload)
109:         resp.raise_for_status()
110:         data = resp.json()
111: 
112:         if data.get("result") != "SUCCESS" and "sessionKey" not in data:
113:             raise CronometerError(f"Login failed: {data}")
114: 
115:         self._user_id = data["id"]
116:         self._token = data["sessionKey"]
117:         logger.info(
118:             "Cronometer login successful (userId=%d, token_len=%d)",
119:             self._user_id,
120:             len(self._token) if self._token else 0,
121:         )
122: 
123:     def _ensure_auth(self) -> None:
124:         """Login lazily on first use."""
125:         if self._token is None:
126:             self.login()
127: 
128:     def _auth_block(self) -> dict:
129:         return {
130:             "userId": self._user_id,
131:             "token": self._token,
132:             **_APP_AUTH_TEMPLATE,
133:         }
134: 
135:     # ------------------------------------------------------------------
136:     # Request helpers
137:     # ------------------------------------------------------------------
138: 
139:     def _request(self, endpoint: str, payload: dict, *, _retried: bool = False) -> dict:
140:         """Send a v2 POST request with JSON auth block. Re-authenticates once on failure."""
141:         self._ensure_auth()
142: 
143:         payload["auth"] = self._auth_block()
144:         payload.setdefault("lastSeen", 0)
145: 
146:         logger.debug("Cronometer v2 request: POST %s", endpoint)
147:         resp = self._http.post(endpoint, json=payload)
148: 
149:         # Check for auth-related failures and retry once
150:         if resp.status_code in (401, 403) and not _retried:
151:             logger.warning(
152:                 "Cronometer auth rejected (%d), re-authenticating",
153:                 resp.status_code,
154:             )
155:             self._token = None
156:             self.login()
157:             return self._request(endpoint, payload, _retried=True)
158: 
159:         resp.raise_for_status()
160:         data = resp.json()
161: 
162:         # Some endpoints return errors in the body
163:         if isinstance(data, dict) and data.get("result") == "FAILURE":
164:             if not _retried:
165:                 logger.warning("Cronometer request failed, re-authenticating: %s", data)
166:                 self._token = None
167:                 self.login()
168:                 return self._request(endpoint, payload, _retried=True)
169:             raise CronometerError(f"Cronometer API error: {data}")
170: 
171:         return data
172: 
173:     def _v3_headers(self) -> dict:
174:         """Headers for v3 REST API requests (auth via headers, not JSON body)."""
175:         return {
176:             "x-crono-session": self._token,
177:             "x-crono-app-os": "android",
178:             "x-crono-app-build-number": "2807",
179:             "x-crono-app-version": "4.48.2",
180:             "content-type": "application/json; charset=utf-8",
181:         }
182: 
183:     def _request_v3(
184:         self,
185:         method: str,
186:         path: str,
187:         *,
188:         json_body: dict | None = None,
189:         _retried: bool = False,
190:     ) -> httpx.Response:
191:         """Send a v3 REST API request. Auth is via x-crono-session header.
192: 
193:         The v3 API uses RESTful conventions: HTTP verbs, path-based routing,
194:         and standard status codes (e.g. 204 for successful deletes).
195: 
196:         Returns the raw httpx.Response (caller handles status interpretation).
197:         """
198:         self._ensure_auth()
199: 
200:         url = f"/api/v3/user/{self._user_id}{path}"
201:         logger.debug("Cronometer v3 request: %s %s", method, url)
202: 
203:         resp = self._http.request(
204:             method, url, json=json_body, headers=self._v3_headers()
205:         )
206: 
207:         # Re-authenticate once on auth failures
208:         if resp.status_code in (401, 403) and not _retried:
209:             logger.warning(
210:                 "Cronometer v3 auth rejected (%d), re-authenticating",
211:                 resp.status_code,
212:             )
213:             self._token = None
214:             self.login()
215:             return self._request_v3(method, path, json_body=json_body, _retried=True)
216: 
217:         return resp
218: 
219:     # ------------------------------------------------------------------
220:     # Date helpers
221:     # ------------------------------------------------------------------
222: 
223:     def _local_today(self) -> date:
224:         """Return today's date in the configured local timezone."""
225:         from zoneinfo import ZoneInfo
226:         tz = ZoneInfo(os.getenv("CRONOMETER_TIMEZONE", "UTC"))
227:         return datetime.now(tz=tz).date()
228: 
229:     def _format_day(self, d: date | None = None) -> str:
230:         """Format a date as Cronometer expects: non-zero-padded 'YYYY-M-D'."""
231:         d = d or self._local_today()
232:         return f"{d.year}-{d.month}-{d.day}"
233: 
234:     # ------------------------------------------------------------------
235:     # Food search
236:     # ------------------------------------------------------------------
237: 
238:     def search_food(self, query: str) -> list[dict]:
239:         """Search the Cronometer food database.
240: 
241:         Returns a list of food entries, each with keys:
242:         id, name, measureId, translationId, measureDisplayName, source,
243:         globalPopularity, score, etc.
244:         """
245:         payload = {
246:             "query": query,
247:             "tab": "ALL",
248:             "sources": ["All"],
249:             "config": {
250:                 "newSearch": True,
251:                 "newSpellcheck": True,
252:                 "call_version": 1,
253:             },
254:         }
255:         data = self._request("/api/v2/find_food", payload)
256:         foods = data.get("foods", [])
257:         logger.info("Food search for %r returned %d results", query, len(foods))
258:         return foods
259: 
260:     # ------------------------------------------------------------------
261:     # Food details
262:     # ------------------------------------------------------------------
263: 
264:     def get_food(self, food_id: int) -> dict:
265:         """Fetch full food details, including server-assigned measure IDs.
266: 
267:         Returns the full food object with keys: id, name, measures,
268:         defaultMeasureId, nutrients, etc.
269:         """
270:         payload = {"id": food_id, "config": {"call_version": 1}}
271:         data = self._request("/api/v2/get_food", payload)
272:         logger.info(
273:             "Fetched food %d: %r (defaultMeasureId=%s)",
274:             food_id,
275:             data.get("name"),
276:             data.get("defaultMeasureId"),
277:         )
278:         return data
279: 
280:     # ------------------------------------------------------------------
281:     # Custom food creation
282:     # ------------------------------------------------------------------
283: 
284:     def create_custom_food(
285:         self,
286:         name: str,
287:         *,
288:         calories: float,
289:         protein_g: float,
290:         fat_g: float,
291:         carbs_g: float,
292:         fiber_g: float = 0,
293:         sugar_g: float = 0,
294:         sodium_mg: float = 0,
295:         serving_name: str = "1 serving",
296:         serving_grams: float = 100.0,
297:     ) -> dict:
298:         """Create a custom food in Cronometer.
299: 
300:         Nutrient amounts are per the full serving (serving_grams).
301:         They are normalized to per-100g internally, since Cronometer stores
302:         all nutrient data on a per-100g basis.
303: 
304:         Returns {"food_id": int, "measure_id": int | None}.
305:         """
306:         # Cronometer stores nutrients per 100g -- normalize from per-serving.
307:         scale = 100.0 / serving_grams if serving_grams > 0 else 1.0
308: 
309:         net_carbs = max(0, carbs_g - fiber_g)
310: 
311:         nutrients = [
312:             {"id": NUTRIENT_IDS["energy"], "amount": round(calories * scale, 2)},
313:             {"id": NUTRIENT_IDS["protein"], "amount": round(protein_g * scale, 2)},
314:             {"id": NUTRIENT_IDS["fat"], "amount": round(fat_g * scale, 2)},
315:             {"id": NUTRIENT_IDS["carbs"], "amount": round(carbs_g * scale, 2)},
316:             {"id": NUTRIENT_IDS["fiber"], "amount": round(fiber_g * scale, 2)},
317:             {"id": NUTRIENT_IDS["sugar"], "amount": round(sugar_g * scale, 2)},
318:             {"id": NUTRIENT_IDS["sodium"], "amount": round(sodium_mg * scale, 2)},
319:             # Derived / calculated fields the app includes
320:             {"id": -203, "amount": round(protein_g * scale, 2)},
321:             {"id": -204, "amount": round(fat_g * scale, 2)},
322:             {"id": -205, "amount": round(carbs_g * scale, 2)},
323:             {"id": -221, "amount": 0},  # alcohol
324:             {"id": NUTRIENT_IDS["net_carbs"], "amount": round(net_carbs * scale, 2)},
325:         ]
326: 
327:         payload = {
328:             "data": {
329:                 "id": 0,
330:                 "name": name,
331:                 "category": 0,
332:                 "owner": None,
333:                 "retired": None,
334:                 "source": None,
335:                 "defaultMeasureId": 0,
336:                 "comments": None,
337:                 "alternateId": None,
338:                 "measures": [
339:                     {
340:                         "id": 0,
341:                         "name": serving_name,
342:                         "value": serving_grams,
343:                         "amount": 1.0,
344:                         "type": "Atomic",
345:                     }
346:                 ],
347:                 "labelType": "AMERICAN_2016",
348:                 "nutrients": nutrients,
349:                 "properties": {},
350:                 "foodTags": [],
351:             },
352:             "config": {"call_version": 1},
353:         }
354: 
355:         data = self._request("/api/v2/add_food", payload)
356:         food_id = data.get("id")
357:         if not food_id:
358:             raise CronometerError(f"Failed to create custom food: {data}")
359: 
360:         logger.info("Created custom food %r (id=%d)", name, food_id)
361:         return {"food_id": food_id, "measure_id": None}
362: 
363:     # ------------------------------------------------------------------
364:     # Diary: add serving
365:     # ------------------------------------------------------------------
366: 
367:     def add_serving(
368:         self,
369:         food_id: int,
370:         measure_id: int | None,
371:         grams: float,
372:         translation_id: int = 0,
373:         day: date | None = None,
374:         diary_group: int = 0,
375:     ) -> dict:
376:         """Log a food serving to the diary.
377: 
378:         Args:
379:             food_id: Cronometer food ID.
380:             measure_id: Measure/unit ID. Get this from search_food() results
381:                         (measureId field) or get_food() (defaultMeasureId or measures[].id).
382:                         0 is only valid for user-created custom foods; database-sourced
383:                         foods (CRDB/NCCDB/FDC) require a real measure ID.
384:             grams: Weight in grams.
385:             translation_id: Translation ID (from search results, usually 0).
386:             day: Date to log to. Defaults to today.
387:             diary_group: Meal group. 0 = auto (based on time of day),
388:                          1 = Breakfast, 2 = Lunch, 3 = Dinner, 4 = Snacks.
389: 
390:         Returns the serving confirmation dict from the API.
391:         """
392:         _tz = ZoneInfo(os.getenv("CRONOMETER_TIMEZONE", "UTC"))
393:         now = datetime.now(tz=_tz)
394:         day_str = self._format_day(day)
395:         time_str = f"{now.hour}:{now.minute}:{now.second}"
396: 
397:         if diary_group == 0:
398:             diary_group = _meal_group_for_hour(now.hour)
399: 
400:         serving = {
401:             "order": (diary_group << 16) | 1,
402:             "day": day_str,
403:             "time": time_str,
404:             "offset": None,
405:             "source": None,
406:             "userId": self._user_id,
407:             "servingId": None,
408:             "type": "Serving",
409:             "foodId": food_id,
410:             "measureId": measure_id or 0,
411:             "grams": grams,
412:             "translationId": translation_id,
413:         }
414: 
415:         payload = {
416:             "serving": serving,
417:             "config": {"call_version": 2},
418:         }
419: 
420:         data = self._request("/api/v2/add_serving", payload)
421:         logger.info(
422:             "Logged serving: food_id=%d, grams=%.1f, day=%s (serving_id=%s)",
423:             food_id,
424:             grams,
425:             day_str,
426:             data.get("id"),
427:         )
428:         return data
429: 
430:     # ------------------------------------------------------------------
431:     # Diary: get diary entries
432:     # ------------------------------------------------------------------
433: 
434:     def get_diary(self, day: date | None = None) -> dict:
435:         """Get all diary entries for a given day.
436: 
437:         Args:
438:             day: Date to fetch. Defaults to today.
439: 
440:         Returns the full diary response from the API.
441:         """
442:         payload = {
443:             "day": self._format_day(day),
444:             "config": {"call_version": 1},
445:         }
446:         data = self._request("/api/v2/get_diary", payload)
447:         logger.info("Fetched diary for %s", self._format_day(day))
448:         return data
449: 
450:     # ------------------------------------------------------------------
451:     # Diary: delete entries
452:     # ------------------------------------------------------------------
453: 
454:     def delete_entries(self, entry_ids: list[str], day: date | None = None) -> dict:
455:         """Remove diary entries by their serving IDs.
456: 
457:         Fetches the diary for the given day, matches entries by servingId,
458:         and sends the full serving objects to the v3 DELETE endpoint.
459: 
460:         Uses: DELETE /api/v3/user/{userId}/diary-entries
461: 
462:         Args:
463:             entry_ids: List of serving IDs to delete (as strings).
464:             day: The day the entries belong to. Defaults to today.
465: 
466:         Returns dict with removed IDs and count.
467:         """
468:         # Fetch the diary to get full serving objects (required by v3 API)
469:         diary_data = self.get_diary(day)
470:         diary_entries = diary_data.get("diary", [])
471: 
472:         id_set = set(str(eid) for eid in entry_ids)
473:         to_delete = []
474:         for entry in diary_entries:
475:             if str(entry.get("servingId")) in id_set:
476:                 to_delete.append(entry)
477: 
478:         if not to_delete:
479:             logger.warning(
480:                 "None of the requested entry IDs found in diary for %s",
481:                 self._format_day(day),
482:             )
483:             return {"removed": [], "count": 0}
484: 
485:         resp = self._request_v3(
486:             "DELETE",
487:             "/diary-entries",
488:             json_body={"diaryEntries": to_delete},
489:         )
490: 
491:         if resp.status_code == 204:
492:             removed_ids = [str(e["servingId"]) for e in to_delete]
493:             logger.info(
494:                 "Deleted %d entries for %s: %s",
495:                 len(removed_ids),
496:                 self._format_day(day),
497:                 removed_ids,
498:             )
499:             return {"removed": removed_ids, "count": len(removed_ids)}
500:         else:
501:             raise CronometerError(
502:                 f"Delete failed with status {resp.status_code}: {resp.text[:300]}"
503:             )
504: 
505:     # ------------------------------------------------------------------
506:     # Diary: mark day complete
507:     # ------------------------------------------------------------------
508: 
509:     def mark_day_complete(self, day: date | None = None, complete: bool = True) -> dict:
510:         """Mark a diary day as complete or incomplete.
511: 
512:         Args:
513:             day: Date to mark. Defaults to today.
514:             complete: True to mark complete, False for incomplete.
515: 
516:         Returns the API response.
517:         """
518:         payload = {
519:             "day": self._format_day(day),
520:             "complete": complete,
521:             "config": {"call_version": 1},
522:         }
523:         data = self._request("/api/v2/set_complete", payload)
524:         status = "complete" if complete else "incomplete"
525:         logger.info("Marked %s as %s", self._format_day(day), status)
526:         return data
527: 
528:     # ------------------------------------------------------------------
529:     # Diary: copy from yesterday
530:     # ------------------------------------------------------------------
531: 
532:     def copy_day(
533:         self, from_day: date | None = None, to_day: date | None = None
534:     ) -> dict:
535:         """Copy all diary entries from one day to another.
536: 
537:         Uses: POST /api/v2/copy
538: 
539:         Args:
540:             from_day: Source date. Defaults to yesterday.
541:             to_day: Destination date. Defaults to today.
542: 
543:         Returns the API response with the copied entries.
544:         """
545:         from datetime import timedelta
546: 
547:         to_day = to_day or self._local_today()
548:         from_day = from_day or (to_day - timedelta(days=1))
549: 
550:         payload = {
551:             "from": self._format_day(from_day),
552:             "to": self._format_day(to_day),
553:             "diaryGroupNumber": None,
554:             "config": {"call_version": 1},
555:         }
556:         data = self._request("/api/v2/copy", payload)
557:         logger.info(
558:             "Copied entries from %s to %s",
559:             self._format_day(from_day),
560:             self._format_day(to_day),
561:         )
562:         return data
563: 
564:     # ------------------------------------------------------------------
565:     # Nutrition: get nutrients
566:     # ------------------------------------------------------------------
567: 
568:     def get_nutrients(self, day: date | None = None) -> dict:
569:         """Get nutrient totals for a given day.
570: 
571:         Args:
572:             day: Date to fetch. Defaults to today.
573: 
574:         Returns the nutrient summary from the API.
575:         """
576:         payload = {
577:             "day": self._format_day(day),
578:             "config": {"call_version": 1},
579:         }
580:         data = self._request("/api/v2/get_nutrients", payload)
581:         logger.info("Fetched nutrients for %s", self._format_day(day))
582:         return data
583: 
584:     def get_nutrition_scores(
585:         self, day: date | None = None, *, include_supplements: bool = True
586:     ) -> dict:
587:         """Get nutrition scores with per-nutrient consumed amounts.
588: 
589:         This is the richest nutrition endpoint -- it returns category scores
590:         (All Targets, Vitamins, Minerals, Electrolytes, Antioxidants, Immune
591:         Support, Metabolism, Bone Health, etc.) with the actual consumed amount
592:         and confidence level for each nutrient.
593: 
594:         Automatically fetches the diary to obtain serving IDs.
595: 
596:         Uses: POST /api/v2/get_nutrition_scores
597: 
598:         Args:
599:             day: Date to score. Defaults to today.
600:             include_supplements: Whether to include supplements in scoring.
601: 
602:         Returns the nutrition scores from the API.
603:         """
604:         diary_data = self.get_diary(day)
605:         diary_entries = diary_data.get("diary", [])
606: 
607:         serving_ids = [
608:             e["servingId"]
609:             for e in diary_entries
610:             if e.get("type") == "Serving" and "servingId" in e
611:         ]
612: 
613:         payload = {
614:             "startDay": "1900-1-1",
615:             "endDay": "1900-1-1",
616:             "servingIds": serving_ids,
617:             "supplements": "true" if include_supplements else "false",
618:             "config": {"call_version": 1},
619:         }
620:         data = self._request("/api/v2/get_nutrition_scores", payload)
621:         logger.info(
622:             "Fetched nutrition scores for %s (%d servings)",
623:             self._format_day(day),
624:             len(serving_ids),
625:         )
626:         return data
627: 
628:     # ------------------------------------------------------------------
629:     # Macro targets
630:     # ------------------------------------------------------------------
631: 
632:     def get_macro_schedules(self) -> dict:
633:         """Get the weekly macro target schedule.
634: 
635:         Returns the schedule mapping days of week to macro templates.
636:         """
637:         payload = {"config": {"call_version": 1}}
638:         data = self._request("/api/v2/get_macro_schedules", payload)
639:         logger.info("Fetched macro schedules")
640:         return data
641: 
642:     def get_macro_target_templates(self) -> dict:
643:         """Get all saved macro target templates.
644: 
645:         Returns the list of macro target templates with their values.
646:         """
647:         payload = {"config": {"call_version": 1}}
648:         data = self._request("/api/v2/get_macro_target_templates", payload)
649:         logger.info("Fetched macro target templates")
650:         return data
651: 
652:     # ------------------------------------------------------------------
653:     # Fasting
654:     # ------------------------------------------------------------------
655: 
656:     def get_fasting_with_date_range(
657:         self, start: date | None = None, end: date | None = None
658:     ) -> dict:
659:         """Get fasting history for a date range.
660: 
661:         Args:
662:             start: Start date. Defaults to 30 days ago.
663:             end: End date. Defaults to today.
664: 
665:         Returns fasting entries from the API.
666:         """
667:         from datetime import timedelta
668: 
669:         end = end or self._local_today()
670:         start = start or (end - timedelta(days=30))
671: 
672:         payload = {
673:             "start": self._format_day(start),
674:             "end": self._format_day(end),
675:             "config": {"call_version": 1},
676:         }
677:         data = self._request("/api/v2/get_fasting_with_date_range", payload)
678:         logger.info("Fetched fasting data %s to %s", start, end)
679:         return data
680: 
681:     def get_fasting_stats(self) -> dict:
682:         """Get aggregate fasting statistics.
683: 
684:         Returns total fasting hours, longest fast, averages, etc.
685:         """
686:         payload = {"config": {"call_version": 1}}
687:         data = self._request("/api/v2/get_fasting_stats", payload)
688:         logger.info("Fetched fasting stats")
689:         return data
690: 
691: 
692: # ======================================================================
693: # Helpers
694: # ======================================================================
695: 
696: 
697: def _meal_group_for_hour(hour: int) -> int:
698:     """Map hour of day to a Cronometer diary meal group.
699: 
700:     1 = Breakfast, 2 = Lunch, 3 = Dinner, 4 = Snacks.
701:     """
702:     if 4 <= hour < 10:
703:         return 1  # Breakfast
704:     elif 10 <= hour < 14:
705:         return 2  # Lunch
706:     elif 14 <= hour < 21:
707:         return 3  # Dinner
708:     else:
709:         return 4  # Snacks
</file>

