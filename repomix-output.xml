<file path="Dockerfile">
 1: # Cronometer MCP image, wrapped with supergateway.
 2: #
 3: # Contract (same for every MCP hosted by this gateway):
 4: #   - Exposes MCP streamable-HTTP on 0.0.0.0:$PORT at /mcp
 5: #   - Health endpoint at /healthz
 6: #   - stdio-speaking MCP process is spawned by supergateway as a child;
 7: #     supergateway handles protocol translation, session binding, and
 8: #     server->client SSE notifications.
 9: #
10: # The gateway reverse-proxies HTTP into this container. No stdio, Docker
11: # attach, or EOF games are required anywhere.
12: #
13: # Base image: supercorp/supergateway:uvx (Alpine + Node 20 + uv).
14: # We install Python 3.14 via uv (cronometer-api-mcp requires >=3.14).
15: #
16: # ⚠️  SECURITY WARNING — READ BEFORE EXPOSING THIS IMAGE PUBLICLY
17: # This entrypoint runs the MCP in STDIO mode under supergateway. In stdio mode
18: # the app NEVER applies OAuthAuthorizationMiddleware (that code path only runs
19: # when MCP_TRANSPORT=streamable-http or sse). So this image, as built, exposes
20: # every MCP tool with NO authentication. Do NOT expose this container directly
21: # to the public internet. Either:
22: #   (a) run it only behind an authenticating reverse proxy / private network
23: #       (Caddy basicauth, Cloudflare Access, Tailscale, etc.), or
24: #   (b) deploy using the native transport instead (MCP_TRANSPORT=streamable-http
25: #       with MCP_AUTH_TOKEN and MCP_APPROVE_SECRET set), which engages the
26: #       built-in OAuth approve-secret gate. The native path is what the
27: #       hosted Railway deployment uses.
28: 
29: FROM supercorp/supergateway:uvx
30: 
31: ENV PYTHONDONTWRITEBYTECODE=1 \
32:     PYTHONUNBUFFERED=1 \
33:     UV_LINK_MODE=copy \
34:     UV_PYTHON_INSTALL_DIR=/opt/uv-python \
35:     UV_TOOL_DIR=/opt/uv-tools \
36:     UV_TOOL_BIN_DIR=/usr/local/bin \
37:     PORT=8080
38: 
39: WORKDIR /app
40: 
41: # Copy the package source. Uses the .dockerignore alongside this file.
42: COPY pyproject.toml README.md ./
43: COPY src ./src
44: 
45: # Pre-install Python 3.14 into a deterministic location, then install the MCP
46: # as a uv tool so its console entry point (`cronometer-api-mcp`) lands in
47: # /usr/local/bin on $PATH.
48: RUN uv python install 3.14 \
49:     && uv tool install --python 3.14 . \
50:     && cronometer-api-mcp --help >/dev/null 2>&1 || true
51: 
52: # supergateway wraps the stdio MCP; Nomad (or docker run -p) remaps $PORT.
53: # --stateful enables Mcp-Session-Id semantics per the MCP streamable-HTTP spec.
54: # --sessionTimeout is unused here because gateway owns reaping via Nomad;
55: #   we still set a generous value so a forgotten session eventually self-heals.
56: ENTRYPOINT ["/bin/sh", "-c", "exec supergateway \
57:   --stdio 'cronometer-api-mcp' \
58:   --outputTransport streamableHttp \
59:   --stateful \
60:   --streamableHttpPath /mcp \
61:   --healthEndpoint /healthz \
62:   --port \"${PORT}\" \
63:   --sessionTimeout 3600000 \
64:   --logLevel info"]
</file>

