311: pending = self._pending_codes.pop(code, None)
312: if pending is None:
313:     # ... existing invalid_grant ...
314:     return
315: 
316: if time.monotonic() - pending.get("created_at", 0) > CODE_TTL_S:
317:     await JSONResponse({"error": "invalid_grant",
318:                         "error_description": "Code expired"}, status_code=400)(scope, receive, send)
319:     return
320: # ... existing PKCE check ...
321: ```
