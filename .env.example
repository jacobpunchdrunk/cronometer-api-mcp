CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=

# --- Remote transport (Railway / hosted) ---
# Required when MCP_TRANSPORT=streamable-http or sse. The server refuses to
# start a remote transport unless BOTH of these are set.
MCP_AUTH_TOKEN=         # bearer token that gates the MCP endpoint (header only). Generate: openssl rand -hex 32
MCP_APPROVE_SECRET=     # secret you type ONCE in the browser approve page when connecting. Keep DISTINCT from MCP_AUTH_TOKEN (min 16 chars). Generate: openssl rand -hex 32
